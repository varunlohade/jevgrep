#!/usr/bin/env python3
"""jevgrep: search code by meaning. Ask "where do we retry failed payments?", get file:line ranges.

  jevgrep "<question>" [dir] [-k 5] [--json]

Needs TYPESAFE_API_KEY (env, ~/.config/jevgrep/key, ./.env or ~/.env). Sends code summaries (names, identifiers,
short strings) to TypeSafe's jev model. Do not use it on code you may not share.
Pure Python 3.9+ standard library. MIT licensed.
"""
import hashlib, json, os, pickle, re, sys, time, urllib.error, urllib.request

API = "https://api.typesafe.ai/v1/systemone"


def load_key():
    if os.environ.get("TYPESAFE_API_KEY"):
        return os.environ["TYPESAFE_API_KEY"]
    keyfile = os.path.expanduser("~/.config/jevgrep/key")
    if os.path.exists(keyfile):
        return open(keyfile).read().strip()
    for path in (".env", os.path.expanduser("~/.env")):
        if os.path.exists(path):
            for line in open(path):
                if line.startswith("TYPESAFE_API_KEY="):
                    return line.split("=", 1)[1].strip().strip('"')
    sys.exit("jevgrep: set TYPESAFE_API_KEY (env, ~/.config/jevgrep/key, ./.env or ~/.env)")


_CONN = __import__("threading").local()

def post_json(url, key, body):
    """POST to jev over a kept-open HTTPS connection (one per thread), with retries and backoff."""
    import http.client, random
    from urllib.parse import urlparse
    u = urlparse(url)
    data = json.dumps(body).encode()
    headers = {"Authorization": f"Bearer {key}", "Content-Type": "application/json"}
    for attempt in range(6):
        conn = getattr(_CONN, "c", None)
        if conn is None:
            conn = _CONN.c = http.client.HTTPSConnection(u.netloc, timeout=60)
        try:
            conn.request("POST", u.path, data, headers)
            r = conn.getresponse()
            payload = r.read()
        except (OSError, http.client.HTTPException):
            _CONN.c = None
            conn.close()
            if attempt < 5:
                time.sleep(0.2 * 2 ** attempt); continue
            raise RuntimeError("jev connection failed") from None
        if r.status == 200:
            return json.loads(payload)
        if r.status in (408, 429, 500, 502, 503, 504, 520, 521, 522, 524, 529) and attempt < 5:
            time.sleep(0.4 * 2 ** attempt + random.random() * 0.3); continue
        raise RuntimeError(f"jev returned HTTP {r.status}: {payload[:200]!r}")
    raise RuntimeError("jev unavailable")


CODE_EXT = {".swift", ".py", ".js", ".ts", ".tsx", ".jsx", ".dart", ".go", ".kt", ".java", ".rb", ".rs",
            ".c", ".cc", ".cpp", ".h", ".m", ".mm", ".cs", ".php", ".scala", ".sh"}
SKIP_DIRS = {".git", "node_modules", "build", "dist", ".venv", "venv", "Pods", ".dart_tool", "DerivedData", "__pycache__"}
DECL = re.compile(r"^\s*(?:@\w+(?:\([^)]*\))?\s+)*(?:(?:public|private|fileprivate|internal|open|static|final|override|"
                  r"async|export|default|mutating|abstract|pub)\s+)*(?:func|fn|def|function|class|struct|enum|extension|"
                  r"protocol|interface|impl|trait)\b")

# Typed-language methods have no keyword: "Future<Response> fetch(...) {", "Widget build(...) {".
METHOD = re.compile(r"^\s*(?:@\w+(?:\([^)]*\))?\s+)*(?!(?:try|await|return|throw|else|case|guard|if|let|var|final\s+\w+\s*=|new|yield|print)\b)"
                    r"(?:(?:static|const|external|factory|override|public|private|protected|abstract|synchronized|async)\s+)*"
                    r"[\w<>?,\[\].]+(?:<[^()=;]*>)?\??\s+(?:get\s+|set\s+)?(?!(?:if|for|while|switch|catch|return|in)\b)[A-Za-z_]\w*"
                    r"\s*(?:<[^()=;]*>)?\s*\((?![^;]*;\s*$)[^=]*$")

def is_decl(line):
    return bool(DECL.match(line) or (METHOD.match(line) and "=" not in line.split("(")[0]))

def code_files(root):
    import subprocess
    try:
        out = subprocess.run(["git", "-C", root, "ls-files"], capture_output=True, text=True, timeout=10).stdout.split("\n")
        files = [f for f in out if f]
    except Exception:
        files = []
    if not files:
        for d, dirs, names in os.walk(root):
            dirs[:] = [x for x in dirs if x not in SKIP_DIRS and not x.startswith(".")]
            files += [os.path.relpath(os.path.join(d, n), root) for n in names]
    generated = re.compile(r"\.(g|freezed|gr|mocks|pb|pbenum|pbjson|pbserver)\.dart$|\.min\.js$|\.d\.ts$")
    return [f for f in files if os.path.splitext(f)[1] in CODE_EXT and not generated.search(f)
            and not any(p in SKIP_DIRS for p in f.split("/"))]

STOP = set("where what which when does do is are the a an of to in on for and or how app code that this it its from with by be as at user users when into get gets".split())

def split_ident(word):
    return [w.lower() for w in re.findall(r"[A-Z]+(?![a-z])|[A-Z]?[a-z]+|\d+", word)]

def stem(w):
    for suf in ("ing", "ed", "es", "s"):
        if w.endswith(suf) and len(w) - len(suf) >= 4:
            return w[: -len(suf)]
    return w

def chunks_of(lines, cap=150):
    """Whole declarations: doc comments stay with their function, tiny headers merge forward."""
    starts = sorted({0, *[i for i, l in enumerate(lines) if is_decl(l)]})
    fixed = []
    for s in starts:  # pull leading comments / attributes into the chunk
        while s > 0 and re.match(r"\s*(//|@|#|/\*|\*)", lines[s - 1]):
            s -= 1
        fixed.append(s)
    starts = sorted(set(fixed))
    spans = list(zip(starts, starts[1:] + [len(lines)]))
    merged = []
    for a, b in spans:
        if merged and merged[-1][1] - merged[-1][0] < 8:   # header too small to stand alone
            merged[-1] = (merged[-1][0], b)
        else:
            merged.append((a, b))
    out = []
    for a, b in merged:
        for s in range(a, b, cap):
            out.append((a, s, min(b, s + cap)))  # (decl start, piece start, piece end)
    return out

def summary(f, lines, a, s, b):
    """What jev sees per chunk: signature + every identifier and string used inside."""
    sig = next((l.strip() for l in lines[a:b] if is_decl(l)), lines[a].strip())[:120]
    body = "\n".join(lines[s:b])
    idents, seen = [], set()
    for w in re.findall(r"[A-Za-z_][A-Za-z0-9_]{3,}", body):
        if w not in seen and w.lower() not in STOP:
            seen.add(w); idents.append(w)
    strings = re.findall(r'"([^"\n]{4,40})"', body)[:6]
    text = f"{f}:{s + 1}-{b} {sig} | uses: {' '.join(idents[:45])}"
    if strings:
        text += " | text: " + " / ".join(strings)
    return text[:420], {t for w in seen for t in split_ident(w)} | {w.lower() for w in re.findall(r"[a-z]{4,}", " ".join(strings).lower())}

KEY = None

def ask(question, criteria, state=None):
    body = {"model": os.environ.get("TYPESAFE_MODEL", "jev-latest"), "state": state or {},
            "questions": {"q": {"type": "choice", "criteria": criteria, "instructions": {"question": question}}}}
    return post_json(API, KEY, body)["answers"]["q"]

CACHE_DIR = os.path.expanduser("~/.cache/jevgrep")
CACHE_VERSION = "5"  # bump when chunking or summaries change

def indexed(root, files):
    """Chunk and summarise every file once; keep it on disk keyed by mtime."""
    path = os.path.join(CACHE_DIR, hashlib.sha1((CACHE_VERSION + root).encode()).hexdigest()[:16] + ".pkl")
    try:
        cache = pickle.load(open(path, "rb"))
    except Exception:
        cache = {}
    out, dirty = {}, False
    for f in files:
        full = os.path.join(root, f)
        try:
            m = os.path.getmtime(full)
        except OSError:
            continue
        hit = cache.get(f)
        if not hit or hit[0] != m:
            lines = open(full, errors="replace").read().splitlines()
            decls = "; ".join(re.sub(r"\s+", " ", l.strip())[:60] for l in lines if is_decl(l))
            hit = (m, decls, [(a, s, b, *summary(f, lines, a, s, b)) for a, s, b in chunks_of(lines)])
            cache[f] = hit; dirty = True
        out[f] = hit
    if dirty:
        os.makedirs(CACHE_DIR, exist_ok=True)
        pickle.dump({f: cache[f] for f in out}, open(path, "wb"))
    inv_path = path[:-4] + ".inv.pkl"
    try:
        if dirty:
            raise FileNotFoundError
        INV.update(pickle.load(open(inv_path, "rb")))
    except Exception:
        INV.clear()
        for f, hit in out.items():
            for t in set().union(*(c[4] for c in hit[2])) if hit[2] else ():
                INV.setdefault(t, []).append(f)
        pickle.dump(INV, open(inv_path, "wb"))
    return out

INV = {}  # token -> [files that use it], cached next to the index

def grep_lane(qwords, idx, top_files=60):
    """Chunks scored by how many question words they use. The token index narrows it to the best files first."""
    matched = {}
    for q in qwords:
        matched[q] = {t for t in INV if t.startswith(q) or (q.startswith(t) and len(t) >= 4)}
    fscore = {}
    for q, toks in matched.items():
        for f in {f for t in toks for f in INV[t]}:
            fscore[f] = fscore.get(f, 0) + 1
    best = sorted(fscore, key=lambda f: (-fscore[f], f))[:top_files]
    ranked = []
    for f in best:
        for c in idx[f][2]:
            sc = sum(1 for toks in matched.values() if c[4] & toks)
            if sc:
                ranked.append((sc, f, c))
    ranked.sort(key=lambda x: (-x[0], x[1], x[2][1]))
    return ranked

def fit(criteria, limit=80_000):
    """Keep a jev request under its size limit by trimming each option evenly."""
    size = sum(len(v) for v in criteria.values())
    if size <= limit:
        return criteria
    cap = max(60, int(limit / max(len(criteria), 1)))
    return {k: v[:cap] for k, v in criteria.items()}

def top_keys(answer, n, cum_stop=0.97):
    ranked = sorted(answer["probabilities"].items(), key=lambda kv: -kv[1])
    out, cum = [], 0.0
    for key, p in ranked[:n]:
        out.append(key); cum += p
        if cum >= cum_stop:
            break
    return out

MAX_OPTIONS = 200  # jev rejects questions with more than ~250 options

def pick_folders(question, folders, n=6):
    """Pick likely folders. Too many? Group them by path prefix, pick groups first, then folders inside."""
    names = sorted(folders)
    if len(names) > MAX_OPTIONS:
        depth = max(len(d.split("/")) for d in names)
        while depth > 1 and len({"/".join(d.split("/")[:depth]) for d in names}) > MAX_OPTIONS:
            depth -= 1
        groups = {}
        for d in names:
            groups.setdefault("/".join(d.split("/")[:depth]), []).append(d)
        gnames = sorted(groups)[:MAX_OPTIONS]
        crit = {str(i + 1): f"{g}/: " + ", ".join(sorted({d[len(g):].strip("/").split("/")[0] or "." for d in groups[g]}))[:300]
                for i, g in enumerate(gnames)}
        a = ask(f"Which folder most likely contains the code that answers: {question}", fit(crit, 70_000))
        names = [d for key in top_keys(a, n, 0.95) for d in groups[gnames[int(key) - 1]]][:MAX_OPTIONS]
    crit = {str(i + 1): f"{d}: " + ", ".join(os.path.splitext(os.path.basename(x))[0] for x in folders[d])
            for i, d in enumerate(names)}
    a = ask(f"Which folder most likely contains the code that answers: {question}", fit(crit, 70_000))
    return [names[int(key) - 1] for key in top_keys(a, n, 0.95)]

FILE_YES = ("true", "A file at this path plausibly contains code matching the search.")
FILE_NO = ("false", "Unrelated by name and location, or generated output, config, or boilerplate that would not hold it.")
DIR_YES = "The folder plausibly contains, at any depth, at least one file matching the search."
DIR_NO = "Nothing about the folder's name, location, or listed files suggests it holds a match."
CODE_YES = "The code directly implements, decides, or defines what the search describes."
CODE_NO = "The code is unrelated, or only shares surface words with the search without doing the thing itself."
BATCH = 64       # yes/no questions per request
PARALLEL = 8     # requests in flight (jev queues bigger bursts)
FOLDER_ROUND_ABOVE = int(os.environ.get("JEVGREP_FOLDER_ROUND_ABOVE", "200"))  # bigger repos pick folders first: two small rounds beat one big wave

def nouls(question, state, items, instruction, yes, no):
    """One yes/no question per item, batched and sent in parallel. Returns P(yes) per item.
    Absolute probabilities (not a share of one pick) let us keep everything above a threshold."""
    from concurrent.futures import ThreadPoolExecutor
    def run(part):
        qs = {f"q{i:03d}": {"type": "noul", "instructions": instruction(key),
                             "criteria": {"true": yes, "false": no}} for i, key in enumerate(part)}
        body = {"model": os.environ.get("TYPESAFE_MODEL", "jev-latest"), "state": {**state, "search": question},
                "questions": qs}
        ans = post_json(API, KEY, body)["answers"]
        return [ans.get(f"q{i:03d}", {}).get("noul", 0.0) for i in range(len(part))]
    parts = [items[i:i + BATCH] for i in range(0, len(items), BATCH)]
    with ThreadPoolExecutor(PARALLEL) as pool:
        return [p for chunk in pool.map(run, parts) for p in chunk]

def keep(items, scores, tau, cap, floor=3):
    """Everything at or above tau (at most cap); never fewer than floor, so a timid model still returns leads."""
    order = sorted(range(len(items)), key=lambda i: -scores[i])
    picked = [i for i in order if scores[i] >= tau][:cap]
    return [items[i] for i in (picked if len(picked) >= floor else order[:floor])]

def tagged_code(lines, a, b, budget=2400):
    out, used = [], 0
    for n in range(a, b):
        row = f"L{n + 1}| {lines[n]}"
        if used + len(row) > budget:
            out.append("…"); break
        out.append(row); used += len(row) + 1
    return "\n".join(out)

def find(root, question, k=5, max_chunks=MAX_OPTIONS, as_json=False):
    """Search code by meaning.
    1. grep lane: question words vs identifier parts (local, free).
    2. folders, then files: one yes/no per entry, keep all above a threshold (big repos only for folders).
    3. chunks: jev picks from whole-declaration summaries.
    4. check: the top candidates are judged again on their real, line-numbered code."""
    t0 = time.perf_counter()
    files = code_files(root)
    if not files:
        return f"no code files under {root}"
    idx = indexed(root, files)
    files = [f for f in files if f in idx]
    t_index = time.perf_counter()
    qwords = {stem(w) for w in re.findall(r"[a-z]{3,}", question.lower()) if w not in STOP}
    def gscore(tokens):
        return sum(any(t.startswith(q) or q.startswith(t) and len(t) >= 4 for t in tokens) for q in qwords)
    graded = grep_lane(qwords, idx)
    grep_hits = [(f, c) for sc, f, c in graded[:8] if sc > 0]
    grep_files = list(dict.fromkeys(f for sc, f, c in graded if sc > 0))[:30]
    # Folders (big repos): yes/no per folder from its path and file names.
    shortlist = list(files)
    if len(files) > FOLDER_ROUND_ABOVE:
        folders = {}
        for f in files:
            folders.setdefault(os.path.dirname(f) or ".", []).append(f)
        names = sorted(folders)
        from concurrent.futures import ThreadPoolExecutor as _Pool
        def judge_folders(part):
            st = {"task": "Semantic grep over a source tree: find folders likely to hold the code the search describes.",
                  "folders": {f"f{i:03d}": {"path": d, "files": [os.path.basename(x) for x in folders[d]][:25]}
                              for i, d in enumerate(part)}}
            return nouls(question, st, [f"f{i:03d}" for i in range(len(part))],
                         lambda key: f"Does folder `folders.{key}` contain, at any depth, a file relevant to this search: \"{question}\"?",
                         DIR_YES, DIR_NO)
        with _Pool(PARALLEL) as pool:
            ps = [p for chunk in pool.map(judge_folders, [names[i:i + BATCH] for i in range(0, len(names), BATCH)]) for p in chunk]
        best = keep(names, ps, 0.3, 12)
        shortlist = list(dict.fromkeys(grep_files + [f for d in best for f in folders[d]]))[:3 * BATCH]
    t_short = time.perf_counter()
    # Files: yes/no per file from its path and declared names.
    parts = [shortlist[i:i + BATCH] for i in range(0, len(shortlist), BATCH)]
    fps = []
    from concurrent.futures import ThreadPoolExecutor
    def judge_files(part):
        state = {"task": "Semantic grep: judge which source files likely hold the code the search describes.",
                 "files": {f"e{i:03d}": {"path": f, "declares": idx[f][1][:300]} for i, f in enumerate(part)}}
        return nouls(question, state, [f"e{i:03d}" for i in range(len(part))],
                     lambda key: f"Is file `files.{key}` likely to contain what this search is looking for: \"{question}\"?",
                     FILE_YES[1], FILE_NO[1])
    with ThreadPoolExecutor(PARALLEL) as pool:
        for chunk in pool.map(judge_files, parts):
            fps += chunk
    top_files = keep(shortlist, fps, 0.4, 8)
    t1 = time.perf_counter()
    # Chunks: jev picks from whole-declaration summaries.
    cands, seen = [], set()
    for f, c in grep_hits + [(f, c) for f in top_files for c in idx[f][2]]:
        if (f, c[1]) not in seen:
            seen.add((f, c[1])); cands.append((f, c))
    cands = cands[:max_chunks]
    cands = cands[:160]
    a = ask(f"Which code chunk answers: {question}", fit({str(i + 1): c[3] for i, (f, c) in enumerate(cands)}, 45_000))
    pick_p = {int(key) - 1: p for key, p in a["probabilities"].items()}
    shortlist_chunks = sorted(range(len(cands)), key=lambda i: -pick_p.get(i, 0))[:8]
    for f, c in grep_hits[:2]:                     # grep's best always get a real-code check too
        i = cands.index((f, c))
        if i not in shortlist_chunks:
            shortlist_chunks.append(i)
    t2 = time.perf_counter()
    # Check: judge each candidate on its real, line-numbered code.
    state = {"task": "Semantic grep: decide whether each code passage actually contains what the search describes.",
             "passages": {f"c{j:02d}": {"file": cands[i][0], "code": tagged_code(idx_lines(root, cands[i][0]), cands[i][1][1], cands[i][1][2])}
                          for j, i in enumerate(shortlist_chunks)}}
    vs = nouls(question, state, [f"c{j:02d}" for j in range(len(shortlist_chunks))],
               lambda key: f"Does passage `passages.{key}` actually contain what this search describes: \"{question}\"?",
               CODE_YES, CODE_NO)
    verified = sorted(zip(shortlist_chunks, vs), key=lambda iv: (-iv[1], -pick_p.get(iv[0], 0)))
    t3 = time.perf_counter()
    picks = [cands[i] + (v,) for i, v in verified[:k]]
    top = {(f, c[1]) for f, c, _ in picks}
    extra = [(f, c) for f, c in grep_hits[:2] if (f, c[1]) not in top]
    ms = lambda a_, b_: round((b_ - a_) * 1000)
    if as_json:
        hit = lambda f, c, src, p: {"file": f, "start": c[1] + 1, "end": c[2], "score": p, "source": src,
                                    "signature": c[3].split(" | ")[0].split(" ", 1)[-1]}
        return json.dumps({"question": question, "root": root, "ms": ms(t0, t3), "files": len(files),
                           "hits": [hit(f, c, "jev", round(p, 3)) for f, c, p in picks] +
                                   [hit(f, c, "grep", None) for f, c in extra]}, indent=1)
    lines = [f"{question}  ({len(files)} files → {len(shortlist)} → {len(top_files)} + grep → {len(cands)} chunks → "
             f"{len(shortlist_chunks)} checked; {ms(t0, t3)}ms = index {ms(t0, t_index)} + folders {ms(t_index, t_short)} "
             f"+ files {ms(t_short, t1)} + chunks {ms(t1, t2)} + check {ms(t2, t3)})"]
    for f, c, p in picks:
        lines.append(f"  {p:.2f}  {f}:{c[1] + 1}-{c[2]}  {c[3].split(' | ')[0].split(' ', 1)[-1][:80]}")
    for f, c in extra:
        lines.append(f"  grep  {f}:{c[1] + 1}-{c[2]}  {c[3].split(' | ')[0].split(' ', 1)[-1][:80]}")
    return "\n".join(lines)

def idx_lines(root, f):
    return open(os.path.join(root, f), errors="replace").read().splitlines()


def main():
    global KEY
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__); return
    k, as_json = 5, "--json" in a
    a = [x for x in a if x != "--json"]
    if "-k" in a:
        i = a.index("-k"); k = int(a[i + 1]); del a[i:i + 2]
    KEY = load_key()
    question, root = a[0], os.path.abspath(a[1] if len(a) > 1 else ".")
    try:
        print(find(root, question, k=k, as_json=as_json))
    except RuntimeError as e:
        sys.exit(f"jevgrep: {e}")


if __name__ == "__main__":
    main()
